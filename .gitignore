__pycache__/
*.py[cod]

# PyInstaller output. thisthat.spec is checked in -- it is the build config,
# not a generated file -- so it is excluded from the *.spec rule below.
build/
dist/
*.spec
!thisthat.spec

# Build venvs, one per machine (see build.bat)
.venv*/

# MkDocs output. The user guide is built and published by
# .github/workflows/docs.yml, so the built site is never committed.
site/
